# Copy to .env (never commit .env). Every VITE_* value is baked into the bundle at build time and is
# therefore PUBLIC: never put a secret here. After changing one on Vercel, redeploy (a restart is not enough).

# Supabase project URL and the *anon* key (Settings > API). Access is enforced by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Web Push (VAPID) key. Must be the pair of the VAPID_PRIVATE_KEY stored in the Supabase
# Edge Function secrets, otherwise the push service answers 403.
VITE_VAPID_PUBLIC_KEY=

# Public hCaptcha site key (the secret key is entered in Supabase > Authentication > Attack Protection).
# Optional: the app falls back to the production site key when this is empty.
VITE_CAPTCHA_SITE_KEY=

# Server-side secrets live ONLY in Supabase Edge Function secrets, never in this project:
#   SUPABASE_SERVICE_ROLE_KEY, VAPID_PRIVATE_KEY, VAPID_PUBLIC_KEY, VAPID_SUBJECT,
#   payment gateway credentials (app_settings, sensitive = true)
