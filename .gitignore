# Secrets: never commit; copy .env.example to .env
.env
.env.*
!.env.example

# Graphify: cache et artefacts lourds régénérables (GRAPH_REPORT.md reste versionné)
graphify-out/cache/
graphify-out/graph.json
graphify-out/graph.html
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_*

# HyperFrames : rendus et état local des projets vidéo (les MP4 ne sont jamais commités)
videos/*/renders/
videos/*/.hyperframes/

# style ANIMÉ : fichiers de travail du son (régénérés par audio/build_mix.py ; le mix final est commité en FLAC)
videos/*/audio/bed.wav
videos/*/audio/mix.wav
videos/talkie-walkie/audio/plan.json
videos/grande-puanteur/audio/plan.json
videos/rats-hanoi/audio/plan.json
videos/jarre-zhang-heng/audio/plan.json

# Moteur Blender (Creatorize) : dossiers générés par les rendus, jamais commités
videos/**/faces/
!videos/_creatorize/blender/assets/faces/
videos/**/shots/
videos/**/renders/
videos/**/frames_*/
**/__pycache__/
# Outil konvwa : environnement Python local et lanceurs générés
videos/_konvwa/.venv/
videos/_konvwa/.cache/
# Fichiers générés par post.py (sous-titres, polices copiées)
videos/*/captions.ass
videos/*/fonts/
videos/*/.suite/
# Son généré par « konvwa son » (refait à chaque rendu)
videos/*/audio/clean.wav
videos/*/audio/sfx_bed.wav
videos/*/audio/sound_*.wav
videos/*/audio/premix*.wav
videos/*/audio/final_mix.wav
