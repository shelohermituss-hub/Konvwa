  "usage": {
    "import": "import { metricBox, metricUV, merged } from '../library/module.any.metric-box/index.js';",
    "example": "const slab = new THREE.Mesh(metricBox(16, .58, 3), perMetre(boardConcrete()));   // 2 m tile on every face\nconst rails = new THREE.Mesh(merged([-1, 1].map(s => new THREE.BoxGeometry(14, .1, .12).translate(0, 0, s * .35))), steel);"
  },
  "requires": [],
  "doc": {
    "when": "Any textured box larger than its texture tile (walls, slabs, posts, decks); several parallel thin parts that touch nothing but sit at one height.",
    "avoid": "Using a material repeat to fix stretching per face: it can only be right for one face size.",
    "gotchas": [
      "metricBox UV unit is 1 m by default: pair it with materials whose repeat = 1 / tile metres (perMetre in module.recon.canvas-materials).",
      "merged() keeps position/normal/uv only."
    ],
    "params": {
      "metricBox(w, h, d, unit = 1, seg = [1, 1, 1])": "UV = metres / unit",
      "metricUV(g, unit)": "box projection by normal",
      "merged(geometries)": "non-indexed concat"
    }
  },
