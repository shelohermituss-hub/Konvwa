{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Creatorize style package: style.json (manifest, schema 2) and looks/*.json (look, schema 2)",
 "description": "Generated by scripts/gen-style-schema.mjs from src/shared/stylePackage.ts (StyleManifestZ, LookManifestZ). Do not edit by hand: re-run the script. The root validates style.json; a look validates against #/$defs/look.",
 "$ref": "#/$defs/style",
 "$defs": {
  "style": {
   "type": "object",
   "properties": {
    "schema": {
     "type": "number",
     "const": 2
    },
    "kind": {
     "type": "string",
     "const": "style"
    },
    "id": {
     "type": "string",
     "maxLength": 60
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 60
    },
    "tagline": {
     "default": "",
     "type": "string",
     "maxLength": 200
    },
    "description": {
     "default": "",
     "type": "string",
     "maxLength": 2000
    },
    "base": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9-]{1,60}$"
    },
    "from": {
     "type": "object",
     "properties": {
      "style": {
       "type": "string",
       "maxLength": 60
      },
      "engineVersion": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      }
     },
     "required": [
      "style",
      "engineVersion"
     ]
    },
    "version": {
     "default": 1,
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "dim": {
     "type": "string",
     "enum": [
      "2d",
      "3d"
     ]
    },
    "aspects": {
     "default": [
      "16:9"
     ],
     "minItems": 1,
     "maxItems": 2,
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "16:9",
       "9:16"
      ]
     }
    },
    "defaultLook": {
     "type": "string",
     "pattern": "^[a-z0-9-]{1,40}$"
    },
    "controls": {
     "type": "object",
     "properties": {
      "keep": {
       "maxItems": 60,
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][\\w]*(\\.[a-zA-Z][\\w]*){0,5}$"
       }
      },
      "add": {
       "maxItems": 40,
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "path": {
          "type": "string",
          "pattern": "^[a-zA-Z][\\w]*(\\.[a-zA-Z][\\w]*){0,5}$"
         },
         "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
         },
         "help": {
          "type": "string",
          "maxLength": 600
         },
         "type": {
          "type": "string",
          "enum": [
           "toggle",
           "range",
           "select",
           "color",
           "figures"
          ]
         },
         "min": {
          "type": "number"
         },
         "max": {
          "type": "number"
         },
         "step": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "fmt": {
          "type": "string",
          "enum": [
           "pct",
           "deg",
           "s",
           "x",
           "ppm"
          ]
         },
         "default": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "string",
            "maxLength": 200
           }
          ]
         },
         "options": {
          "maxItems": 60,
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "value": {
             "anyOf": [
              {
               "type": "string",
               "maxLength": 100
              },
              {
               "type": "number"
              }
             ]
            },
            "label": {
             "type": "string",
             "maxLength": 100
            },
            "img": {
             "type": "string",
             "pattern": "^[\\w-]+(\\/[\\w-]+)*\\.(png|jpe?g|webp)$"
            }
           },
           "required": [
            "value",
            "label"
           ]
          }
         },
         "readOnly": {
          "type": "boolean"
         },
         "size": {
          "type": "boolean"
         },
         "clearable": {
          "type": "boolean"
         }
        },
        "required": [
         "path",
         "label",
         "type"
        ]
       }
      },
      "remove": {
       "maxItems": 60,
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][\\w]*(\\.[a-zA-Z][\\w]*){0,5}$"
       }
      }
     }
    },
    "defaults": {
     "default": {},
     "type": "object",
     "propertyNames": {
      "type": "string"
     },
     "additionalProperties": {}
    },
    "capabilities": {
     "default": {},
     "type": "object",
     "properties": {
      "needsImageKey": {
       "type": "boolean"
      },
      "reframe": {
       "type": "boolean"
      },
      "engineCaptions": {
       "type": "boolean"
      },
      "webImages": {
       "type": "boolean"
      }
     }
    },
    "audio": {
     "type": "object",
     "properties": {
      "music": {
       "type": "string",
       "enum": [
        "beds",
        "none",
        "user"
       ]
      },
      "lufs": {
       "type": "number"
      }
     }
    },
    "checks": {
     "type": "object",
     "properties": {
      "layout": {
       "type": "boolean"
      },
      "minText": {
       "type": "number"
      },
      "overlap": {
       "type": "number"
      },
      "mustFail": {
       "maxItems": 40,
       "type": "array",
       "items": {
        "type": "string",
        "maxLength": 200
       }
      }
     }
    },
    "banned": {
     "default": [],
     "maxItems": 100,
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 200
     }
    },
    "prompts": {
     "default": {
      "brief": "",
      "build": "",
      "context": "",
      "qualityBar": "",
      "reframe": "",
      "imageStyle": "",
      "ignoreBaseRefs": []
     },
     "type": "object",
     "properties": {
      "brief": {
       "default": "",
       "type": "string",
       "maxLength": 4000
      },
      "build": {
       "default": "",
       "type": "string",
       "maxLength": 8000
      },
      "context": {
       "default": "",
       "type": "string",
       "maxLength": 8000
      },
      "qualityBar": {
       "default": "",
       "type": "string",
       "maxLength": 4000
      },
      "reframe": {
       "default": "",
       "type": "string",
       "maxLength": 4000
      },
      "imageStyle": {
       "default": "",
       "type": "string",
       "maxLength": 1000
      },
      "ignoreBaseRefs": {
       "default": [],
       "maxItems": 40,
       "type": "array",
       "items": {
        "type": "string",
        "maxLength": 200
       }
      }
     }
    },
    "fonts": {
     "type": "object",
     "properties": {
      "charsets": {
       "maxItems": 20,
       "type": "array",
       "items": {
        "type": "string",
        "maxLength": 40
       }
      }
     }
    },
    "render": {
     "type": "object",
     "properties": {
      "smooth": {
       "type": "boolean"
      }
     }
    },
    "routines": {
     "type": "object",
     "properties": {
      "extras": {
       "type": "object",
       "propertyNames": {
        "type": "string"
       },
       "additionalProperties": {}
      }
     }
    },
    "brand": {
     "type": "object",
     "properties": {
      "help": {
       "type": "string",
       "maxLength": 600
      },
      "use": {
       "type": "string",
       "maxLength": 600
      }
     }
    },
    "official": {
     "default": false,
     "type": "boolean"
    },
    "aliases": {
     "default": [],
     "maxItems": 20,
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^custom-[a-z0-9-]{1,40}$"
     }
    },
    "studio": {
     "type": "object",
     "properties": {
      "workspace": {
       "type": "string",
       "maxLength": 60
      }
     },
     "required": [
      "workspace"
     ]
    },
    "kit": {
     "type": "object",
     "properties": {
      "kit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 9007199254740991
      },
      "app": {
       "type": "string",
       "maxLength": 40
      },
      "host": {
       "type": "string",
       "maxLength": 80
      },
      "base": {
       "type": "string",
       "maxLength": 60
      },
      "baseEngine": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "built": {
       "type": "string",
       "maxLength": 40
      }
     },
     "required": [
      "kit",
      "app",
      "host",
      "base",
      "baseEngine",
      "built"
     ]
    },
    "created": {
     "type": "string",
     "maxLength": 40
    },
    "updated": {
     "type": "string",
     "maxLength": 40
    }
   },
   "required": [
    "schema",
    "kind",
    "id",
    "name",
    "base"
   ]
  },
  "look": {
   "type": "object",
   "properties": {
    "schema": {
     "type": "number",
     "const": 2
    },
    "kind": {
     "type": "string",
     "const": "look"
    },
    "id": {
     "type": "string",
     "pattern": "^look-[a-z0-9-]{1,40}$"
    },
    "style": {
     "type": "string",
     "maxLength": 60
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 60
    },
    "description": {
     "default": "",
     "type": "string",
     "maxLength": 1000
    },
    "settings": {
     "default": {},
     "type": "object",
     "propertyNames": {
      "type": "string"
     },
     "additionalProperties": {}
    },
    "notes": {
     "type": "object",
     "properties": {
      "context": {
       "default": "",
       "type": "string",
       "maxLength": 4000
      },
      "qualityBar": {
       "default": "",
       "type": "string",
       "maxLength": 4000
      }
     }
    },
    "pitfalls": {
     "default": [],
     "maxItems": 100,
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 1000
     }
    },
    "preview": {
     "type": "string",
     "maxLength": 200
    }
   },
   "required": [
    "schema",
    "kind",
    "id",
    "name"
   ]
  }
 }
}
